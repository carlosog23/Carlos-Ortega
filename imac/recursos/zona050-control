#!/usr/bin/env python3
# =====================================================================
#  Zona Escolar 050 · Control de apps de las iMac
#  Lee la lista de apps autorizadas (apps.json en el GitHub de la zona)
#  y deja en la iMac SOLO esas apps: menú, escritorio, página de control
#  y marcadores de Firefox. Corre al encender y cada 30 minutos.
#
#  Uso manual:  sudo zona050-control          (actualiza ahora)
#               zona050-control --estado      (muestra qué apps hay)
# =====================================================================
import html, json, os, re, shutil, sys, time, urllib.request

BASE = "https://carlosog23.github.io/Carlos-Ortega/imac"
DIR_ZONA = "/usr/share/zona050"
DIR_ICONOS = DIR_ZONA + "/iconos"
DIR_ACCESOS = DIR_ZONA + "/accesos"
DIR_CONTROL = DIR_ZONA + "/control"
LISTA_INCLUIDA = DIR_ZONA + "/apps.json"          # la que trae el instalador
DIR_ESTADO = "/var/lib/zona050"
LISTA_GUARDADA = DIR_ESTADO + "/apps.json"        # la última que se bajó bien
APLICACIONES = "/usr/share/applications"
POLITICAS = ["/etc/firefox/policies/policies.json", "/usr/lib/firefox/distribution/policies.json"]
FIJOS = {"zona050-control.desktop", "zona050-impresoras.desktop"}  # no se borran nunca


def bajar(url, segundos=20):
    req = urllib.request.Request(url + ("&" if "?" in url else "?") + "v=%d" % time.time(),
                                 headers={"User-Agent": "zona050-control"})
    with urllib.request.urlopen(req, timeout=segundos) as r:
        return r.read()


def valida(lista):
    """Revisa la lista y regresa solo lo que es seguro usar."""
    apps, sitios = [], []
    for a in lista.get("apps", []):
        if not isinstance(a, dict) or not a.get("activa"):
            continue
        i, url = str(a.get("id", "")), str(a.get("url", ""))
        if not re.fullmatch(r"[a-z0-9-]{1,40}", i) or not url.startswith("https://"):
            continue
        icono = str(a.get("icono", "") or "")
        if icono and not re.fullmatch(r"[A-Za-z0-9._-]{1,60}\.png", icono):
            icono = ""
        apps.append({"id": i, "nombre": str(a.get("nombre", i))[:40],
                     "descripcion": str(a.get("descripcion", ""))[:80], "url": url, "icono": icono})
    for s in lista.get("sitios", []):
        if isinstance(s, dict) and str(s.get("url", "")).startswith("https://"):
            sitios.append({"nombre": str(s.get("nombre", ""))[:30], "url": str(s["url"])})
    return apps, sitios


def leer_lista():
    os.makedirs(DIR_ESTADO, exist_ok=True)
    try:
        datos = json.loads(bajar(BASE + "/apps.json"))
        valida(datos)  # si truena aquí, no se guarda
        with open(LISTA_GUARDADA + ".tmp", "w") as f:
            json.dump(datos, f, ensure_ascii=False, indent=1)
        os.replace(LISTA_GUARDADA + ".tmp", LISTA_GUARDADA)
        return datos, "en línea"
    except Exception as e:
        for ruta, origen in ((LISTA_GUARDADA, "guardada"), (LISTA_INCLUIDA, "del instalador")):
            try:
                with open(ruta) as f:
                    return json.load(f), "%s (sin internet)" % origen
            except Exception:
                pass
    return {"apps": [], "sitios": []}, "vacía"


def icono_de(app):
    if not app["icono"]:
        return "applications-internet"
    ruta = os.path.join(DIR_ICONOS, app["icono"])
    if not os.path.exists(ruta):
        try:
            datos = bajar(BASE + "/recursos/iconos/" + app["icono"])
            if datos[:8] == b"\x89PNG\r\n\x1a\n":
                os.makedirs(DIR_ICONOS, exist_ok=True)
                with open(ruta, "wb") as f:
                    f.write(datos)
        except Exception:
            pass
    return ruta if os.path.exists(ruta) else "applications-internet"


def escribe(ruta, texto, modo=0o644):
    tmp = ruta + ".tmp"
    with open(tmp, "w") as f:
        f.write(texto)
    os.chmod(tmp, modo)
    os.replace(tmp, ruta)


def accesos(apps):
    os.makedirs(DIR_ACCESOS, exist_ok=True)
    quedan = set(FIJOS)
    for a in apps:
        nombre = "zona050-%s.desktop" % a["id"]
        quedan.add(nombre)
        texto = ("[Desktop Entry]\nVersion=1.0\nType=Application\nName=%s\nComment=%s\n"
                 "Exec=firefox --new-window %s\nIcon=%s\nTerminal=false\n"
                 "Categories=Education;Network;\nStartupNotify=true\nX-Zona050-Escritorio=1\n"
                 % (a["nombre"], a["descripcion"], a["url"], icono_de(a)))
        escribe(os.path.join(DIR_ACCESOS, nombre), texto, 0o755)
        shutil.copyfile(os.path.join(DIR_ACCESOS, nombre), os.path.join(APLICACIONES, nombre))
    # Lo que ya no está autorizado se quita del menú
    for d in (DIR_ACCESOS, APLICACIONES):
        for f in os.listdir(d):
            if f.startswith("zona050-") and f.endswith(".desktop") and f not in quedan:
                os.remove(os.path.join(d, f))
    os.system("update-desktop-database %s >/dev/null 2>&1" % APLICACIONES)


def pagina(apps, sitios, origen):
    e = html.escape
    tarjetas = "".join(
        '<a class="app" href="%s">%s<b>%s</b><span>%s</span></a>'
        % (e(a["url"]), ('<img src="%s" alt="">' % e("file://" + a["icono_ruta"])) if a["icono_ruta"].startswith("/") else "",
           e(a["nombre"]), e(a["descripcion"])) for a in apps) or \
        '<p class="vacio">Por ahora no hay apps autorizadas en esta computadora.</p>'
    ligas = "".join('<a href="%s">%s</a>' % (e(s["url"]), e(s["nombre"])) for s in sitios)
    hoy = time.strftime("%d/%m/%Y %H:%M")
    texto = """<!DOCTYPE html>
