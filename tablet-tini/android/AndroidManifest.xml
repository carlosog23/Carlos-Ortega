<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet-Tini · Zona Escolar 050. App para tablets con Android 4.4 en adelante. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="mx.zona050.tablettini">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="Tablet-Tini"
        android:icon="@drawable/ic"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Holo.Light.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustResize">
            <!-- Aparece en el menú de apps -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Puede ser la pantalla de inicio: el botón Inicio regresa a Tablet-Tini -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
