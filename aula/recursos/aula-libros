#!/bin/bash
# aula-libros · Supervisión Escolar Zona 050
# Descarga los libros de texto que falten en la carpeta de la escuela (solo cuando hay internet).
# La lista vive en /usr/share/aula/libros.txt y se actualiza sola desde el repositorio de la zona.
# Formato de cada línea:   carpeta | título | dirección del PDF
#   ejemplo:  1° grado | Proyectos de Aula | https://…/libro.pdf
LISTA=/usr/share/aula/libros.txt
LT="/srv/aula/compartido/Libros de texto"
REMOTO="https://carlosog23.github.io/Carlos-Ortega/aula/recursos/libros.txt"
mkdir -p "$LT"
nuevo=$(mktemp)
if wget -q -T 20 -O "$nuevo" "$REMOTO" && grep -q '|' "$nuevo"; then install -m 644 "$nuevo" "$LISTA"; fi
rm -f "$nuevo"
[ -f "$LISTA" ] || { echo "No hay lista de libros todavía."; exit 0; }
ok=0; mal=0; ya=0
while IFS='|' read -r carpeta titulo url; do
  carpeta=$(echo "$carpeta" | xargs); titulo=$(echo "$titulo" | xargs); url=$(echo "$url" | xargs)
  case "$carpeta" in ''|\#*) continue ;; esac
  [ -n "$titulo" ] && [ -n "$url" ] || continue
  titulo=${titulo//\//-}; carpeta=${carpeta//\//-}
  dest="$LT/$carpeta/$titulo.pdf"
  if [ -s "$dest" ]; then ya=$((ya+1)); continue; fi
  mkdir -p "$LT/$carpeta"
  echo "  ↓ $carpeta · $titulo"
  if wget -q -T 60 -t 3 -c -O "$dest.parcial" "$url" && head -c 5 "$dest.parcial" | grep -q '%PDF'; then
    mv "$dest.parcial" "$dest"; ok=$((ok+1))
  else
    rm -f "$dest.parcial"; mal=$((mal+1)); echo "    ! no se pudo descargar"
  fi
done < "$LISTA"
id maestro >/dev/null 2>&1 && chown -R maestro:maestro "$LT"
echo "Libros de texto: $ok nuevos, $ya ya estaban, $mal con problema."
[ "$mal" = 0 ]
