</script></body></html>
"""
    for k, v in {"icono_zona": e(DIR_ICONOS + "/zona050.png"), "tarjetas": tarjetas, "hoy": hoy, "origen": e(origen),
                 "sitios": ('<div class="sitios"><h2>Sitios</h2>%s</div>' % ligas) if ligas else ""}.items():
        texto = texto.replace("@@%s@@" % k, v)
    os.makedirs(DIR_CONTROL, exist_ok=True)
    escribe(DIR_CONTROL + "/index.html", texto)


def firefox(apps, sitios):
    inicio = "file://" + DIR_CONTROL + "/index.html"
    marcadores = [{"toplevel_name": "Zona 050"}, {"name": "Control de apps", "url": inicio}]
    marcadores += [{"name": a["nombre"], "url": a["url"]} for a in apps]
    marcadores += [{"name": s["nombre"], "url": s["url"]} for s in sitios]
    for ruta in POLITICAS:
        if not os.path.isdir(os.path.dirname(ruta)):
            continue
        try:
            with open(ruta) as f:
                pol = json.load(f)
        except Exception:
            pol = {"policies": {}}
        p = pol.setdefault("policies", {})
        p["Homepage"] = {"URL": inicio, "Locked": False, "StartPage": "homepage"}
        p["ManagedBookmarks"] = marcadores
        escribe(ruta, json.dumps(pol, ensure_ascii=False, indent=2))


def main():
    if "--estado" in sys.argv:
        try:
            with open(DIR_ESTADO + "/estado.json") as f:
                print(json.dumps(json.load(f), ensure_ascii=False, indent=2))
        except Exception:
            print("Todavía no se ha corrido el control de apps.")
        return
    if os.geteuid() != 0:
        sys.exit("Hay que correrlo con sudo:  sudo zona050-control")
    lista, origen = leer_lista()
    apps, sitios = valida(lista)
    accesos(apps)
    for a in apps:
        a["icono_ruta"] = icono_de(a)
    pagina(apps, sitios, origen)
    firefox(apps, sitios)
    estado = {"fecha": time.strftime("%Y-%m-%d %H:%M:%S"), "origen": origen,
              "apps": [a["nombre"] for a in apps]}
    escribe(DIR_ESTADO + "/estado.json", json.dumps(estado, ensure_ascii=False, indent=1))
    print("Control de apps: %s · lista %s" % (", ".join(estado["apps"]) or "ninguna", origen))


if __name__ == "__main__":
    main()
